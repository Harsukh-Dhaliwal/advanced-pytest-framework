ntent=\"width=device-width,initial-scale=1\"><title>Example Domain</title><style>html{color-scheme:light dark;background:light-dark(#eee,#222)}body{font:16px/1.6 system-ui,sans-serif;max-width:26em;margin:auto;padding:25vh 2em 2em;text-align:center}</style></head><body><p>This domain is for use in documentation examples without needing permission. This is not a service; avoid relying on it for testing and monitoring purposes.</p><script src=/s.js></script></body></html>\n"},"headersSize":314,"bodySize":334,"redirectURL":"","_transferSize":645},"cache":{},"timings":{"dns":12.997,"connect":54.54,"ssl":34.547,"send":0,"wait":23.846,"receive":1.091},"_frameref":"frame@0849ed96ea4641503bbd12f9e6e02aca","_monotonicTime":10880.293,"_resourceType":"document","serverIPAddress":"172.66.147.243","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"example.com","issuer":"Cloudflare TLS Issuing ECC CA 3","validFrom":1790462951,"validTo":1798239395}},{"pageref":"page@9b017daa8c7868b1a1370943c243fa1f","startedDateTime":"2026-11-06T21:35:27.521Z","time":72.86,"request":{"method":"GET","url":"https://example.com/s.js","httpVersion":"h3","cookies":[],"headers":[{"name":"Host","value":"example.com"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:157.0) Gecko/20100101 Firefox/157.0"},{"name":"Accept","value":"*/*"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Alt-Used","value":"example.com"},{"name":"Connection","value":"keep-alive"},{"name":"Referer","value":"https://example.com/"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}],"queryString":[],"headersSize":377,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"date","value":"Fri, 06 Nov 2026 21:35:29 GMT"},{"name":"content-type","value":"text/javascript; charset=utf-