nson Hyperlegible Next\";\n  src: url(\"/fonts/atkinson-hyperlegible-next.woff2\") format(\"woff2\");\n  font-weight: 200 800;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Atkinson Hyperlegible Mono\";\n  src: url(\"/fonts/atkinson-hyperlegible-mono.woff2\") format(\"woff2\");\n  font-weight: 200 800;\n  font-display: swap;\n}\n/* saucelabs.com uses P22 Mackinac Pro for headings; Fraunces is the closest open font. */\n@font-face {\n  font-family: \"Fraunces\";\n  src: url(\"/fonts/fraunces.woff2\") format(\"woff2\");\n  font-weight: 100 900;\n  font-display: swap;\n}\n\n:root {\n  --sl-pine: #192319;\n  --sl-pine-light: rgba(25, 35, 25, 0.64);\n  --sl-pine-xlight: rgba(25, 35, 25, 0.24);\n  --sl-forest: #043423;\n  --sl-moss: #3c483c;\n  --sl-ivory: #f0f0ec;\n  --sl-off-white: #f8f8f8;\n  --sl-warm-gray: #dcdcd7;\n  --sl-stone: #c8c8be;\n  --sl-highlight: #abe082;\n  --sl-light-highlight: #f3ffcc;\n  --sl-flare: #f55524;\n  --sl-clay-red: #961001;\n  --sl-deep-shock: #334bc3;\n  --sl-sunflower: #f1be23;\n  --sl-sans: \"Atkinson Hyperlegible Next\", Arial, sans-serif;\n  --sl-serif: \"Fraunces\", \"Times New Roman\", serif;\n  --sl-mono: \"Atkinson Hyperlegible Mono\", Menlo, monospace;\n}\n\n/* Page */\nhtml,\nbody {\n  background: var(--sl-ivory);\n}\nbody {\n  color: var(--sl-pine);\n  font-family: var(--sl-sans);\n}\n\n/* Top bar, drawn with CSS so the DOM stays as it was. Layout pages only. */\nbody:has(> #page-footer)::before {\n  content: \"The Internet\";\n  display: block;\n  background: var(--sl-pine);\n  color: var(--sl-ivory);\n  font-family: var(--sl-serif);\n  font-size: 1.375em;\n  font-weight: 600;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  padding: 1.1em 1.5em;\n  border-bottom: 4px solid var(--sl-highlight);\n}\n\n#flash-messages {\n  padding-top: 1.5em;\n}\n\nbody:has(> #page-footer) #content {\n  background: white;\n  border: 1px solid var(--sl-warm-gray);\n  border-radius: 1.5rem;\n  padding-top: 2em;\n  padding-bottom: 2em;\n}\n\n/* Type */\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--sl-serif);\n  font-weight: 600;\n  color: var(--sl-pine);\n  letter-spacing: -0.01em;\n}\nh4, h5, h6 {\n  color: var(--sl-pine-light);\n}\n.subheader {\n  font-family: var(--sl-sans);\n  font-weight: 400;\n  letter-spacing: 0;\n  color: var(--sl-pine-light);\n}\n/* Icon text (e.g. the Login button label) falls back to the sans font, not serif. */\n.fa {\n  font-family: FontAwesome, \"Atkinson Hyperlegible Next\", Arial, sans-serif;\n}\np,\nli,\nlabel {\n  color: var(--sl-pine);\n}\ncode,\npre,\nkbd,\nsamp {\n  font-family: var(--sl-mono);\n}\nhr {\n  border-color: var(--sl-warm-gray);\n}\n\na {\n  color: var(--sl-deep-shock);\n  text-decoration: underline;\n  text-decoration-color: rgba(51, 75, 195, 0.35);\n  text-underline-offset: 0.2em;\n}\na:hover,\na:focus {\n  color: var(--sl-pine);\n  text-decoration-color: var(--sl-flare);\n}\n\n/* Home page list of examples: the page uses the full width, with up to 4 columns. */\n.row:has(> #content > h1.heading) {\n  max-width: calc(100% - 3em);\n}\n#content h1.heading + h2 {\n  text-align: center;\n}\n#content h1.heading ~ ul {\n  columns: 4 16em;\n  column-gap: 2.5em;\n}\n/* Every item is two lines (name, description). Longer text ends with \"...\"; the full text is in the title. */\n#content h1.heading ~ ul li {\n  break-inside: avoid;\n  padding: 0.35em 0;\n  border-bottom: 1px solid var(--sl-ivory);\n  color: var(--sl-pine-light);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n/* Items clip overflow, so keep a link's focus ring inside the item. */\n#content h1.heading ~ ul li a:focus-visible {\n  outline-offset: -2px;\n}\n#content h1.heading ~ ul li[hidden] {\n  display: none;\n}\n/* The description lives in an attribute so the text of each item stays the same. */\n#content h1.heading ~ ul li[data-description]::after {\n  content: attr(data-description);\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  font-size: 0.85em;\n  color: var(--sl-pine-light);\n}\n#example-filter-box {\n  max-width: 28em;\n  margin: 0 auto 1.75em;\n  text-align: center;\n}\n#example-filter-box label {\n  font-weight: 600;\n}\n#example-filter-box input {\n  margin-bottom: 0.25em;\n}\n#example-filter-empty {\n  color: var(--sl-pine-light);\n}\n\n/* Buttons (sizes unchanged) */\nbutton,\n.button {\n  font-family: var(--sl-sans);\n  background-color: var(--sl-pine);\n  border-color: var(--sl-pine);\n  color: var(--sl-ivory);\n  border-radius: 9999px;\n  text-decoration: none;\n}\nbutton.radius,\n.button.radius {\n  border-radius: 9999px;\n}\nbutton:hover,\nbutton:focus,\n.button:hover,\n.button:focus {\n  background-color: var(--sl-moss);\n  border-color: var(--sl-moss);\n  color: white;\n}\nbutton.secondary,\n.button.secondary {\n  background-color: var(--sl-ivory);\n  border-color: var(--sl-stone);\n  color: var(--sl-pine);\n}\nbutton.secondary:hover,\nbutton.secondary:focus,\n.button.secondary:hover,\n.button.secondary:focus {\n  background-color: var(--sl-warm-gray);\n  color: var(--sl-pine);\n}\nbutton.success,\n.button.success {\n  background-color: var(--sl-highlight);\n  border-color: #8cc865;\n  color: var(--sl-pine);\n}\nbutton.success:hover,\nbutton.success:focus,\n.button.success:hover,\n.button.success:focus {\n  background-color: #96d26c;\n  color: var(--sl-pine);\n}\nbutton.alert,\n.button.alert {\n  background-color: var(--sl-flare);\n  border-color: #d9431a;\n  color: white;\n}\nbutton.alert:hover,\nbutton.alert:focus,\n.button.alert:hover,\n.button.alert:focus {\n  background-color: #d9431a;\n}\nbutton[disabled],\n.button[disabled],\nbutton.disabled,\n.button.disabled {\n  background-color: var(--sl-stone);\n  border-color: var(--sl-stone);\n  color: var(--sl-pine-light);\n}\n\n/* Form fields */\ninput[type=\"text\"],\ninput[type=\"password\"],\ninput[type=\"date\"],\ninput[type=\"datetime\"],\ninput[type=\"datetime-local\"],\ninput[type=\"month\"],\ninput[type=\"week\"],\ninput[type=\"email\"],\ninput[type=\"number\"],\ninput[type=\"search\"],\ninput[type=\"tel\"],\ninput[type=\"time\"],\ninput[type=\"url\"],\ntextarea,\nselect {\n  font-family: var(--sl-sans);\n  color: var(--sl-pine);\n  border-color: var(--sl-stone);\n  border-radius: 0.5rem;\n  box-shadow: none;\n}\ninput[type=\"text\"]:focus,\ninput[type=\"password\"]:focus,\ninput[type=\"email\"]:focus,\ninput[type=\"number\"]:focus,\ninput[type=\"search\"]:focus,\ninput[type=\"tel\"]:focus,\ninput[type=\"url\"]:focus,\ntextarea:focus,\nselect:focus {\n  border-color: var(--sl-pine);\n  outline: 2px solid var(--sl-highlight);\n  outline-offset: 0;\n  background-color: white;\n}\ninput[readonly] {\n  background-color: var(--sl-off-white);\n}\ninput[type=\"checkbox\"],\ninput[type=\"radio\"],\ninput[type=\"range\"] {\n  accent-color: var(--sl-forest);\n}\n\n/* Tables */\ntable {\n  border-color: var(--sl-warm-gray);\n  border-radius: 0.5rem;\n  border-collapse: separate;\n  border-spacing: 0;\n  overflow: hidden;\n}\ntable thead,\ntable tfoot {\n  background: var(--sl-pine);\n}\ntable thead tr th,\ntable thead tr td,\ntable tfoot tr th,\ntable tfoot tr td {\n  color: var(--sl-ivory);\n}\ntable thead tr th a,\ntable thead tr th span {\n  color: var(--sl-ivory);\n}\ntable tr th,\ntable tr td {\n  color: var(--sl-pine);\n}\ntable tr.even,\ntable tr.alt,\ntable tr:nth-of-type(even) {\n  background: var(--sl-off-white);\n}\n\n/* Flash messages and status colours */\n.flash {\n  border-radius: 0.5rem;\n  font-weight: 700;\n}\n.success {\n  background-color: var(--sl-forest);\n  border-color: var(--sl-forest);\n  color: var(--sl-ivory);\n}\n.notice {\n  background-color: var(--sl-deep-shock);\n  border-color: var(--sl-deep-shock);\n  color: white;\n}\n.error {\n  background-color: var(--sl-clay-red);\n  border-color: var(--sl-clay-red);\n  color: white;\n}\n.flash .close {\n  color: white;\n  opacity: 0.6;\n  text-decoration: none;\n}\n\n/* Panels and modals used by some examples */\n.panel {\n  background: var(--sl-ivory);\n  border-color: var(--sl-warm-gray);\n  border-radius: 0.5rem;\n}\n.modal {\n  border-radius: 1rem;\n  border-color: var(--sl-warm-gray);\n}\n.modal-title h3 {\n  color: var(--sl-pine);\n}\n\n/* Footer */\n#page-footer {\n  color: var(--sl-pine-light);\n  font-size: 0.875em;\n  padding: 1.5em 0 2.5em;\n}\n#page-footer hr {\n  display: none;\n}\n\n/* Accessibility of the page chrome */\n.skip-link {\n  position: absolute;\n  left: 1em;\n  top: -10em;\n  z-index: 1000;\n  padding: 0.5em 1em;\n  background: var(--sl-highlight);\n  color: var(--sl-pine);\n  font-weight: 700;\n  border-radius: 0.5rem;\n}\n.skip-link:focus {\n  top: 1em;\n}\n/* A clear focus ring for keyboard users; the mouse doesn't trigger it. */\na:focus-visible,\nbutton:focus-visible,\n.button:focus-visible,\nsummary:focus-visible,\n[tabindex]:focus-visible,\ninput[type=\"checkbox\"]:focus-visible,\ninput[type=\"radio\"]:focus-visible,\ninput[type=\"range\"]:focus-visible,\ninput[type=\"file\"]:focus-visible,\ninput[type=\"submit\"]:focus-visible,\ninput[type=\"button\"]:focus-visible {\n  outline: 3px solid var(--sl-deep-shock);\n  outline-offset: 2px;\n}\na:focus:not(:focus-visible) {\n  outline: 0;\n}\n.flash .close {\n  opacity: 0.85;\n}\n.flash .close:hover,\n.flash .close:focus {\n  opacity: 1;\n}\n.flash .close:focus-visible {\n  outline-color: white;\n}"},"headersSize":1225,"bodySize":9178,"redirectURL":"","_transferSize":10403},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":552.587,"receive":9.421},"_frameref":"frame@da780a4e6f15f409ae85ac26d89c0696","_monotonicTime":18596.527,"_resourceType":"stylesheet","serverIPAddress":"99.83.176.110","_serverPort":443,"_securityDetails":{"protocol":"TLSv1.3","subjectName":"*.herokuapp.com","validFrom":1792976400,"validTo":1810083599}},{"pageref":"page@96f107584da8d361e6cd15d9a94be253","startedDateTime":"2026-11-06T21:35:35.058Z","time":1625.8719999999998,"request":{"method":"GET","url":"https://t