function ($, window, document, undefined) {\n  'use strict';\n\n  Foundation.libs.alerts = {\n    name : 'alerts',\n\n    version : '4.3.2',\n\n    settings : {\n      animation: 'fadeOut',\n      speed: 300, // fade out speed\n      callback: function (){}\n    },\n\n    init : function (scope, method, options) {\n      this.scope = scope || this.scope;\n      Foundation.inherit(this, 'data_options');\n\n      if (typeof method === 'object') {\n        $.extend(true, this.settings, method);\n      }\n\n      if (typeof method !== 'string') {\n        if (!this.settings.init) { this.events(); }\n\n        return this.settings.init;\n      } else {\n        return this[method].call(this, options);\n      }\n    },\n\n    events : function () {\n      var self = this;\n\n      $(this.scope).on('click.fndtn.alerts', '[data-alert] a.close', function (e) {\n          var alertBox = $(this).closest(\"[data-alert]\"),\n              settings = $.extend({}, self.settings, self.data_options(alertBox));\n\n        e.preventDefault();\n        alertBox[settings.animation](settings.speed, function () {\n          $(this).remove();\n          settings.callback();\n        });\n      });\n\n      this.settings.init = true;\n    },\n\n    off : function () {\n      $(this.scope).off('.fndtn.alerts');\n    },\n\n    reflow : function () {}\n  };\n}(Foundation.zj, this, this.document));\n"},"headersSize":1210,"bodySize":1392,"redirectURL":"","_transferSize":2602},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":621.511,"receive":12.306},"_frameref":"frame@da780a4e6f15f409ae85ac26d89c0696","_monotonicTime":18596.655,"_resourceType":"script","serverIPAddress":"99.83.176.110","_serverPort":443,"_securityDetails":{"protocol":"TLSv1.3","subjectName":"*.herokuapp.com","validFrom":1792976400,"validTo":1810083599}},{"pageref":"page@96f107584da8d361e6cd15d9a94be253","startedDateTime":"2026-11-06T21:35:35.058Z","time":1630.3149999999998,"request":{"method":"GET","url":"htt