sulated CLOSED shadow root node boundary\n                            const shadow = this.attachShadow({ mode: 'closed' });\n                            const container = document.createElement('div');\n                            container.id = 'shadow-inner-target';\n                            container.innerText = 'Encapsulated Secure Token Data';\n                            shadow.appendChild(container);\n                            \n                            // Save reference to the closed registry\n                            window.__closedShadowRegistry['host-element'] = shadow;\n                        }\n                    }\n                    customElements.define('custom-input-component', CustomInputComponent);\n                </script>\n            </body>\n        </html>\n        "},"headersSize":66,"bodySize":0,"redirectURL":"","_transferSize":0},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":-1},"_frameref":"frame@2266a8c447a4cdfd463114bd3ad5ccf8","_monotonicTime":10740.331,"_resourceType":"document","_wasFulfilled":true,"_securityDetails":{}}]}}